# Optional - Google Gemini API key (free at https://aistudio.google.com/apikey).
# Without a key, poems are generated from built-in templates.
GEMINI_API_KEY=
# Optional - Gemini model (default gemini-flash-latest)
GEMINI_MODEL=
# Optional - port to listen on (default 5000)
PORT=5000
# Only needed for `npm run db:push`
DATABASE_URL=
